# Copy to .env for local CLI use; use your own isolated Neon development project.
# Runtime and tests: pooled connection, with -pooler in the Neon hostname.
DATABASE_URL="postgresql://app:REPLACE_ME@ep-example-pooler.us-east-1.aws.neon.tech/coach_dev?sslmode=require"
APP_DATABASE_ENV="development"

# Prisma CLI only: direct connection to the same database, without -pooler.
# Do not add DIRECT_URL to Vercel Preview or Production runtime variables.
DIRECT_URL="postgresql://migrator:REPLACE_ME@ep-example.us-east-1.aws.neon.tech/coach_dev?sslmode=require"

# To mark a development/test database, supply its direct endpoint hostname as a
# separate command argument after checking the project in Neon Console.
# Do not save that confirmation argument in this file.

# Optional for a deployed, token-protected HEAD /api/internal/db-verify check.
# Set a distinct random 32-byte-or-longer value in each Vercel environment.
# DB_VERIFY_TOKEN="REPLACE_WITH_RANDOM_TOKEN"
