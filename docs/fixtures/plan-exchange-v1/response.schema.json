{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/__schema0" },
        "requestId": { "$ref": "#/$defs/__schema1" },
        "draftVersion": { "$ref": "#/$defs/__schema2" },
        "macroPlan": { "$ref": "#/$defs/__schema3" },
        "detailWindow": { "$ref": "#/$defs/__schema6" },
        "warnings": { "$ref": "#/$defs/__schema7" },
        "mode": { "type": "string", "const": "initial" },
        "workouts": { "maxItems": 100, "type": "array", "items": { "$ref": "#/$defs/__schema9" } }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "draftVersion",
        "macroPlan",
        "detailWindow",
        "mode",
        "workouts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/__schema0" },
        "requestId": { "$ref": "#/$defs/__schema1" },
        "draftVersion": { "$ref": "#/$defs/__schema2" },
        "macroPlan": { "$ref": "#/$defs/__schema3" },
        "detailWindow": { "$ref": "#/$defs/__schema6" },
        "warnings": { "$ref": "#/$defs/__schema7" },
        "mode": { "type": "string", "const": "refresh" },
        "baseRevisionId": { "$ref": "#/$defs/__schema1" },
        "baseRevisionNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "operations": {
          "maxItems": 100,
          "type": "array",
          "items": { "$ref": "#/$defs/__schema21" }
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "draftVersion",
        "macroPlan",
        "detailWindow",
        "mode",
        "baseRevisionId",
        "baseRevisionNumber",
        "operations"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": { "type": "number", "const": 1 },
    "__schema1": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema2": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "__schema3": {
      "type": "object",
      "properties": {
        "startDate": { "$ref": "#/$defs/__schema4" },
        "endDate": { "$ref": "#/$defs/__schema4" },
        "strategy": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "phases": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": { "$ref": "#/$defs/__schema5" }
        }
      },
      "required": ["startDate", "endDate", "strategy", "phases"],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "startDate": { "$ref": "#/$defs/__schema4" },
        "endDate": { "$ref": "#/$defs/__schema4" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "notes": { "type": "string", "maxLength": 4000 }
      },
      "required": ["startDate", "endDate", "label", "notes"],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "startDate": { "$ref": "#/$defs/__schema4" },
        "endDate": { "$ref": "#/$defs/__schema4" }
      },
      "required": ["startDate", "endDate"],
      "additionalProperties": false
    },
    "__schema7": { "maxItems": 20, "type": "array", "items": { "$ref": "#/$defs/__schema8" } },
    "__schema8": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "__schema9": {
      "type": "object",
      "properties": {
        "workoutId": { "$ref": "#/$defs/__schema1" },
        "scheduledDate": { "$ref": "#/$defs/__schema4" },
        "definition": { "$ref": "#/$defs/__schema10" }
      },
      "required": ["workoutId", "scheduledDate", "definition"],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sport": {
          "type": "string",
          "enum": ["RUNNING", "CYCLING", "SWIMMING", "WALKING", "OTHER"]
        },
        "steps": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": { "$ref": "#/$defs/__schema11" }
        }
      },
      "required": ["schemaVersion", "name", "sport", "steps"],
      "additionalProperties": false
    },
    "__schema11": {
      "oneOf": [
        { "$ref": "#/$defs/__schema12" },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "repeat" },
            "count": { "type": "integer", "minimum": 1, "maximum": 100 },
            "steps": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": { "$ref": "#/$defs/__schema19" }
            }
          },
          "required": ["type", "count", "steps"],
          "additionalProperties": false
        }
      ]
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "step" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "termination": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "time" },
                "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 604800 }
              },
              "required": ["type", "durationSeconds"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "distance" },
                "distanceMeters": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 }
              },
              "required": ["type", "distanceMeters"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": { "type": { "type": "string", "const": "lap" } },
              "required": ["type"],
              "additionalProperties": false
            }
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "properties": { "type": { "type": "string", "const": "free" } },
              "required": ["type"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": { "$ref": "#/$defs/__schema13" },
                "minSecondsPerKm": { "$ref": "#/$defs/__schema14" },
                "maxSecondsPerKm": { "$ref": "#/$defs/__schema15" }
              },
              "required": ["type", "minSecondsPerKm", "maxSecondsPerKm"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": { "$ref": "#/$defs/__schema16" },
                "minBpm": { "$ref": "#/$defs/__schema17" },
                "maxBpm": { "$ref": "#/$defs/__schema18" }
              },
              "required": ["type", "minBpm", "maxBpm"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["type", "termination", "target"],
      "additionalProperties": false
    },
    "__schema13": { "type": "string", "const": "pace" },
    "__schema14": { "type": "number", "exclusiveMinimum": 0, "maximum": 36000 },
    "__schema15": { "type": "number", "exclusiveMinimum": 0, "maximum": 36000 },
    "__schema16": { "type": "string", "const": "heartRate" },
    "__schema17": { "type": "integer", "exclusiveMinimum": 0, "maximum": 300 },
    "__schema18": { "type": "integer", "exclusiveMinimum": 0, "maximum": 300 },
    "__schema19": {
      "oneOf": [
        { "$ref": "#/$defs/__schema12" },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "repeat" },
            "count": { "type": "integer", "minimum": 1, "maximum": 100 },
            "steps": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": { "$ref": "#/$defs/__schema20" }
            }
          },
          "required": ["type", "count", "steps"],
          "additionalProperties": false
        }
      ]
    },
    "__schema20": {
      "oneOf": [
        { "$ref": "#/$defs/__schema12" },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "repeat" },
            "count": { "type": "integer", "minimum": 1, "maximum": 100 },
            "steps": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": { "$ref": "#/$defs/__schema12" }
            }
          },
          "required": ["type", "count", "steps"],
          "additionalProperties": false
        }
      ]
    },
    "__schema21": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "workoutId": { "$ref": "#/$defs/__schema1" },
            "scheduledDate": { "$ref": "#/$defs/__schema4" },
            "definition": { "$ref": "#/$defs/__schema10" },
            "operation": { "type": "string", "const": "create" }
          },
          "required": ["workoutId", "scheduledDate", "definition", "operation"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "workoutId": { "$ref": "#/$defs/__schema1" },
            "scheduledDate": { "$ref": "#/$defs/__schema4" },
            "definition": { "$ref": "#/$defs/__schema10" },
            "operation": { "type": "string", "const": "update" }
          },
          "required": ["workoutId", "scheduledDate", "definition", "operation"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operation": { "type": "string", "const": "cancel" },
            "workoutId": { "$ref": "#/$defs/__schema1" }
          },
          "required": ["operation", "workoutId"],
          "additionalProperties": false
        }
      ]
    }
  },
  "title": "PlanExchangeResponse v1",
  "$comment": "Zod is authoritative. Also enforce calendar validity, timezone/units, coverage/null semantics, consent, unique IDs, matching request/mode/draft and revision versions, phase continuity, allowed future dates/identities and schedule constraints. Recheck live ownership, versions and locks before approval; schema validity does not approve or publish."
}
