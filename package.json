{
  "name": "running-coach",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run src/server/db/client.integration.test.ts src/server/auth/auth.integration.test.ts src/server/athlete/profile.integration.test.ts src/server/provider/vault.integration.test.ts src/server/activity/import.integration.test.ts src/server/activity/history.integration.test.ts src/server/garmin/import-rate-limit.integration.test.ts src/server/garmin/sync.integration.test.ts src/server/garmin/health-sync.integration.test.ts src/server/garmin/data-import.integration.test.ts src/server/garmin/lap-history.integration.test.ts src/server/health/history.integration.test.ts",
    "auth:invite": "node scripts/auth/auth-operator.mjs invite",
    "auth:bootstrap-admin": "node scripts/auth/auth-operator.mjs bootstrap-admin",
    "credentials:rotate": "node scripts/auth/rotate-provider-credentials.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:assert:development": "prisma db execute --schema prisma/scripts/direct.prisma --file prisma/scripts/assert-development-target.sql",
    "db:assert:production": "prisma db execute --schema prisma/scripts/direct.prisma --file prisma/scripts/assert-production-target.sql",
    "db:prepare:run70": "node scripts/migrations/prepare-run70-migrations.mjs",
    "db:mark:nonproduction": "node prisma/scripts/mark-nonproduction.mjs",
    "db:grant:runtime": "prisma db execute --schema prisma/scripts/direct.prisma --file prisma/scripts/grant-runtime.sql",
    "prepare": "husky",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.218.0",
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "6.19.0",
    "@prisma/client": "6.19.0",
    "better-auth": "1.7.14",
    "lucide-react": "1.69.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@storybook/nextjs-vite": "^9.1.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.1",
    "dotenv": "16.6.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.0.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "prettier": "^3.0.0",
    "prisma": "6.19.0",
    "sass": "^1.107.1",
    "storybook": "^9.1.21",
    "typescript": "^5.0.0",
    "vite": "^6.4.5",
    "vitest": "3.2.4"
  }
}
