generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETING
}

enum IntegrationProvider {
  GARMIN
  INTERVALS
  OPENAI
}

enum IntegrationAuthMethod {
  OAUTH
  API_KEY
  FILE
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ActivitySource {
  GARMIN
  INTERVALS
  MANUAL
  FILE
}

enum DatabaseTier {
  NON_PRODUCTION
  PRODUCTION
}

// One private row per database; application code reads it before data access.
model DatabaseIdentity {
  id   Int          @id @db.SmallInt
  tier DatabaseTier

  @@map("database_identity")
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  authSubject String     @unique @map("auth_subject")
  email       String?    @db.VarChar(320)
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile                     AthleteProfile?
  bodyMeasurements            BodyMeasurement[]
  integrationConnections      IntegrationConnection[]
  activities                  Activity[]
  activityDuplicateCandidates ActivityDuplicateCandidate[]
  garminImportRateLimit        GarminImportRateLimit?
  dailyHealthMetrics          DailyHealthMetric[]
  syncRuns                    SyncRun[]

  @@index([status])
  @@map("users")
}

// Better Auth owns credentials and sessions; users remains the application identity.
model AuthUser {
  id                   String        @id
  name                 String
  email                String        @unique
  emailVerified        Boolean       @default(false)
  image                String?
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)
  invitationClaimNonce String?       @unique @map("invitation_claim_nonce") @db.Uuid
  sessions             AuthSession[]
  accounts             AuthAccount[]

  @@map("auth_users")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verifications")
}

model AuthInvitation {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  label        String?   @db.VarChar(120)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  claimedAt    DateTime? @map("claimed_at") @db.Timestamptz(6)
  claimedEmail String?   @map("claimed_email") @db.VarChar(320)
  claimedNonce String?   @unique @map("claimed_nonce") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("auth_invitations")
}

// Shared Better Auth rate limits for serverless instances.
model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
  @@map("auth_rate_limits")
}

model GarminImportRateLimit {
  userId          String   @id @map("user_id") @db.Uuid
  count           Int
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("garmin_import_rate_limits")
}

model AthleteProfile {
  userId                     String    @id @map("user_id") @db.Uuid
  displayName                String?   @map("display_name")
  birthDate                  DateTime? @map("birth_date") @db.Date
  // Legacy profiles may be null until their owner chooses MALE or FEMALE.
  sex                        String?   @db.VarChar(32)
  heightCm                   Decimal?  @map("height_cm") @db.Decimal(5, 2)
  experienceLevel            String    @default("BEGINNER") @map("experience_level")
  preferredTimezone          String?   @map("preferred_timezone")
  // Kept for the migration compatibility window; measurementSystem is authoritative.
  distanceUnit               String?   @map("distance_unit") @ignore
  weightUnit                 String?   @map("weight_unit") @ignore
  measurementSystem          String    @default("METRIC") @map("measurement_system") @db.VarChar(16)
  defaultTrainingDaysPerWeek Int?      @map("default_training_days_per_week") @db.SmallInt
  defaultAvailableWeekdays   Json?     @map("default_available_weekdays")
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("athlete_profiles")
}

model BodyMeasurement {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  measuredAt       DateTime  @map("measured_at") @db.Timestamptz(6)
  measuredOn       DateTime? @map("measured_on") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  measurementType  String    @map("measurement_type") @db.VarChar(32)
  value            Decimal   @db.Decimal(9, 2)
  unit             String    @db.VarChar(16)
  source           String    @db.VarChar(32)
  sourceExternalId String?   @map("source_external_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceExternalId])
  @@index([userId, measurementType, measuredAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "body_measurements_owner_weight_order_idx")
  @@map("body_measurements")
}

model IntegrationConnection {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  provider             IntegrationProvider
  externalAccountId    String?               @map("external_account_id")
  authMethod           IntegrationAuthMethod @map("auth_method")
  status               IntegrationStatus     @default(PENDING)
  grantedScopes        Json?                 @map("granted_scopes")
  credentialsExpiresAt DateTime?             @map("credentials_expires_at") @db.Timestamptz(6)
  lastSuccessAt        DateTime?             @map("last_success_at") @db.Timestamptz(6)
  lastFailureAt        DateTime?             @map("last_failure_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential IntegrationCredential?
  cursors    SyncCursor[]
  syncRuns   SyncRun[]

  @@unique([userId, id])
  @@unique([userId, provider])
  @@unique([userId, provider, externalAccountId])
  @@index([userId, provider, status])
  @@map("integration_connections")
}

model IntegrationCredential {
  connectionId         String   @id @map("connection_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  ciphertext           Bytes
  nonce                Bytes
  authTag              Bytes    @map("auth_tag")
  encryptionKeyVersion Int      @map("encryption_key_version")
  rotatedAt            DateTime @default(now()) @map("rotated_at") @db.Timestamptz(6)

  connection IntegrationConnection @relation(fields: [userId, connectionId], references: [userId, id], onDelete: Cascade)

  @@unique([userId, connectionId])
  @@index([userId])
  @@map("integration_credentials")
}

model SyncCursor {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  connectionId       String    @map("connection_id") @db.Uuid
  dataType           String    @map("data_type")
  cursorOrCheckpoint Json      @map("cursor_or_checkpoint")
  lastSyncedAt       DateTime? @map("last_synced_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  connection IntegrationConnection @relation(fields: [userId, connectionId], references: [userId, id], onDelete: Cascade)

  @@unique([connectionId, dataType])
  @@index([userId, connectionId])
  @@map("sync_cursors")
}

model SyncRun {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  connectionId      String     @map("connection_id") @db.Uuid
  jobType           String     @map("job_type")
  status            SyncStatus @default(RUNNING)
  startedAt         DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?  @map("finished_at") @db.Timestamptz(6)
  recordsSeen       Int        @default(0) @map("records_seen")
  recordsWritten    Int        @default(0) @map("records_written")
  retryCount        Int        @default(0) @map("retry_count")
  checkpointSummary Json?      @map("checkpoint_summary")
  errorCode         String?    @map("error_code")
  errorSafeMessage  String?    @map("error_safe_message")

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [userId, connectionId], references: [userId, id], onDelete: Cascade)

  @@index([connectionId, startedAt(sort: Desc)])
  @@index([status, startedAt])
  @@index([userId, startedAt(sort: Desc)])
  @@map("sync_runs")
}

model Activity {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @map("user_id") @db.Uuid
  sourceProvider       ActivitySource @map("source_provider")
  externalActivityId   String?        @map("external_activity_id")
  externalActivityUuid String?        @map("external_activity_uuid")
  sourceRecordType     String         @default("API_ACTIVITY") @map("source_record_type")
  sportType            String         @map("sport_type")
  sourceSportType      String?        @map("source_sport_type")
  surfaceType          String?        @map("surface_type")
  startedAt            DateTime       @map("started_at") @db.Timestamptz(6)
  listStartedAt        DateTime       @map("list_started_at") @db.Timestamptz(6)
  sourceTimezone       String?        @map("source_timezone")
  distanceMeters       Decimal?       @map("distance_meters") @db.Decimal(12, 3)
  totalMs              BigInt?        @map("total_ms")
  elapsedMs            BigInt?        @map("elapsed_ms")
  movingMs             BigInt?        @map("moving_ms")
  avgSpeedMps          Decimal?       @map("avg_speed_mps") @db.Decimal(12, 6)
  avgHrBpm             Int?           @map("avg_hr_bpm")
  maxHrBpm             Int?           @map("max_hr_bpm")
  cadence              Decimal?       @db.Decimal(7, 2)
  elevationGainMeters  Decimal?       @map("elevation_gain_meters") @db.Decimal(9, 2)
  elevationLossMeters  Decimal?       @map("elevation_loss_meters") @db.Decimal(9, 2)
  calories             Int?
  activityTitle        String?        @map("activity_title")
  rawObjectRef         String?        @map("raw_object_ref")
  gpsAssetRef          String?        @map("gps_asset_ref")
  lapImportStatus      String         @default("UNAVAILABLE") @map("lap_import_status") @db.VarChar(24)
  sourceObservedAt     DateTime?      @map("source_observed_at") @db.Timestamptz(6)
  externalModifiedAt   DateTime?      @map("external_modified_at") @db.Timestamptz(6)
  importedAt           DateTime       @default(now()) @map("imported_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  laps                        ActivityLap[]
  duplicateCandidatesAsFirst  ActivityDuplicateCandidate[] @relation("DuplicateFirst")
  duplicateCandidatesAsSecond ActivityDuplicateCandidate[] @relation("DuplicateSecond")

  @@unique([userId, id])
  @@unique([userId, sourceProvider, externalActivityId])
  @@index([userId, listStartedAt(sort: Desc), id(sort: Desc)])
  @@map("activities")
}

model ActivityLap {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  activityId            String    @map("activity_id") @db.Uuid
  lapIndex              Int       @map("lap_index")
  sourceRecordType      String    @map("source_record_type") @db.VarChar(32)
  startedAt             DateTime? @map("started_at") @db.Timestamptz(6)
  distanceMeters        Decimal?  @map("distance_meters") @db.Decimal(12, 3)
  elapsedMs             BigInt?   @map("elapsed_ms")
  movingMs              BigInt?   @map("moving_ms")
  avgHrBpm              Int?      @map("avg_hr_bpm")
  avgSpeedMps           Decimal?  @map("avg_speed_mps") @db.Decimal(12, 6)
  cadenceStepsPerMinute Decimal?  @map("cadence_steps_per_minute") @db.Decimal(7, 2)

  activity Activity @relation(fields: [userId, activityId], references: [userId, id], onDelete: Cascade)

  @@unique([activityId, lapIndex])
  @@index([userId, activityId])
  @@map("activity_laps")
}

model ActivityDuplicateCandidate {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  firstActivityId  String   @map("first_activity_id") @db.Uuid
  secondActivityId String   @map("second_activity_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  first  Activity @relation("DuplicateFirst", fields: [userId, firstActivityId], references: [userId, id], onDelete: Cascade)
  second Activity @relation("DuplicateSecond", fields: [userId, secondActivityId], references: [userId, id], onDelete: Cascade)

  @@unique([firstActivityId, secondActivityId], map: "activity_duplicate_candidates_pair_key")
  @@index([userId, secondActivityId])
  @@map("activity_duplicate_candidates")
}

model DailyHealthMetric {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  sourceProvider  ActivitySource @map("source_provider")
  localDate       DateTime       @map("local_date") @db.Date
  sourceTimezone  String         @map("source_timezone")
  restingHrBpm    Int?           @map("resting_hr_bpm")
  hrvMs           Decimal?       @map("hrv_ms") @db.Decimal(9, 2)
  sleepDurationMs BigInt?        @map("sleep_duration_ms")
  sleepScore      Int?           @map("sleep_score")
  steps           Int?
  stress          Int?
  bodyBattery     Int?           @map("body_battery")
  rawMetadata     Json?          @map("raw_metadata")
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceProvider, localDate])
  @@index([userId, localDate(sort: Desc)])
  @@map("daily_health_metrics")
}
